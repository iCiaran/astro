---
import { getCollection } from 'astro:content'

const blogEntries = await getCollection('blog');
const newsEntries = await getCollection('news');

---

<h1 id="blog" data-blog-entries={JSON.stringify(blogEntries)}>Blog entries length: {blogEntries.length}</h1>
<h1 id="news" data-news-entries={JSON.stringify(newsEntries)}>News entries length: {newsEntries.length}</h1>
